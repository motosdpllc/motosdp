'use client'
import { useState, useEffect } from 'react'
import { supabase, fmt, fmtDate, type Cliente, type PagoStripe } from '@/lib/supabase'
import toast from 'react-hot-toast'
import { DollarSign, Plus, Search, CheckCircle, Clock } from 'lucide-react'

export default function PagosPage() {
  const [pagos, setPagos] = useState<PagoStripe[]>([])
  const [clientes, setClientes] = useState<Cliente[]>([])
  const [loading, setLoading] = useState(true)
  const [view, setView] = useState<'list' | 'form'>('list')
  const [editId, setEditId] = useState<string | null>(null)

  // Estado del formulario
  const [form, setForm] = useState<PagoStripe>({
    id: '', monto: 0, fecha_pago: new Date().toISOString().split('T')[0],
    descripcion: '', stripe_id: '', status: 'Pagado'
  })
  const [cliSearch, setCliSearch] = useState('')
  const [showCliDrop, setShowCliDrop] = useState(false)
  const [filtros, setFiltros] = useState({ cliente_id: '', status: '', search: '' })

  useEffect(() => {
    loadPagosAndClientes()
  }, [])

  const loadPagosAndClientes = async () => {
    setLoading(true)
    try {
      const [pagosRes, clientesRes] = await Promise.all([
        supabase.from('pagos_stripe').select('*').order('fecha_pago', { ascending: false }),
        supabase.from('clientes').select('id, nombre, telefono').order('nombre')
      ])
      setPagos(pagosRes.data || [])
      setClientes(clientesRes.data || [])
    } catch (err) {
      toast.error('Error al cargar datos')
      console.error(err)
    } finally {
      setLoading(false)
    }
  }

  const handleCliSearch = (value: string) => {
    setCliSearch(value)
    setShowCliDrop(value.length > 0)
  }

  const selectCliente = (cli: Cliente) => {
    setForm(p => ({ ...p, cliente_id: cli.id, cliente_nombre: cli.nombre }))
    setCliSearch(cli.nombre)
    setShowCliDrop(false)
  }

  const guardarPago = async (e: React.FormEvent) => {
    e.preventDefault()
    if (form.monto <= 0) { toast.error('El monto debe ser mayor que 0'); return }
    if (!form.fecha_pago) { toast.error('La fecha de pago es obligatoria'); return }

    try {
      if (editId) {
        await supabase.from('pagos_stripe').update(form).eq('id', editId)
        toast.success('Pago actualizado ✓')
      } else {
        await supabase.from('pagos_stripe').insert([form])
        toast.success('Pago registrado ✓')
      }
      setForm({ id: '', monto: 0, fecha_pago: new Date().toISOString().split('T')[0], descripcion: '', stripe_id: '', status: 'Pagado' })
      setCliSearch('')
      setView('list')
      setEditId(null)
      loadPagosAndClientes()
    } catch (err) {
      toast.error('Error al guardar pago')
      console.error(err)
    }
  }

  const editarPago = (pago: PagoStripe) => {
    setForm(pago)
    setCliSearch(clientes.find(c => c.id === pago.cliente_id)?.nombre || '')
    setEditId(pago.id)
    setView('form')
  }

  const eliminarPago = async (id: string) => {
    if (!confirm('¿Eliminar este pago?')) return
    try {
      await supabase.from('pagos_stripe').delete().eq('id', id)
      toast.success('Pago eliminado ✓')
      loadPagosAndClientes()
    } catch (err) {
      toast.error('Error al eliminar pago')
      console.error(err)
    }
  }

  const filteredPagos = pagos.filter(pago => {
    let match = true;
    if (filtros.cliente_id && pago.cliente_id !== filtros.cliente_id) match = false;
    if (filtros.status && pago.status !== filtros.status) match = false;
    if (filtros.search && !pago.descripcion?.toLowerCase().includes(filtros.search.toLowerCase()) && !clientes.find(c => c.id === pago.cliente_id)?.nombre.toLowerCase().includes(filtros.search.toLowerCase())) match = false;
    return match;
  });

  const getClienteNombre = (clienteId?: string) => {
    return clientes.find(c => c.id === clienteId)?.nombre || 'Cliente no encontrado';
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'Pagado': return 'bg-green-100 text-green-800';
      case 'Pendiente': return 'bg-yellow-100 text-yellow-800';
      case 'Reembolsado': return 'bg-red-100 text-red-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  if (loading) {
    return <div className="min-h-screen bg-gray-50 p-6 flex items-center justify-center"><p className="text-gray-500 text-lg">Cargando...</p></div>;
  }

  if (view === 'form') {
    return (
      <div className="min-h-screen bg-gray-50 p-6">
        <div className="max-w-xl mx-auto bg-white rounded-lg shadow-xl p-8">
          <button onClick={() => setView('list')} className="mb-6 px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 font-semibold">
            ← Volver a la lista
          </button>
          <h1 className="text-3xl font-bold mb-6">{editId ? 'Editar Pago' : 'Registrar Nuevo Pago'}</h1>

          <form onSubmit={guardarPago}>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div>
                <label className="block text-sm font-bold mb-1">Monto *</label>
                <input type="number" step="0.01" value={form.monto} onChange={e => setForm(p => ({ ...p, monto: parseFloat(e.target.value) || 0 }))} className="w-full border rounded px-3 py-2" required />
              </div>
              <div>
                <label className="block text-sm font-bold mb-1">Fecha de Pago *</label>
                <input type="date" value={form.fecha_pago} onChange={e => setForm(p => ({ ...p, fecha_pago: e.target.value }))} className="w-full border rounded px-3 py-2" required />
              </div>
              <div>
                <label className="block text-sm font-bold mb-1">Descripción</label>
                <input type="text" value={form.descripcion || ''} onChange={e => setForm(p => ({ ...p, descripcion: e.target.value }))} className="w-full border rounded px-3 py-2" />
              </div>
              <div>
                <label className="block text-sm font-bold mb-1">ID de Stripe (opcional)</label>
                <input type="text" value={form.stripe_id || ''} onChange={e => setForm(p => ({ ...p, stripe_id: e.target.value }))} className="w-full border rounded px-3 py-2" />
              </div>
              <div>
                <label className="block text-sm font-bold mb-1">Nro. Venta (opcional)</label>
                <input type="text" value={form.nro_venta || ''} onChange={e => setForm(p => ({ ...p, nro_venta: e.target.value }))} className="w-full border rounded px-3 py-2" />
              </div>
              <div>
                <label className="block text-sm font-bold mb-1">Estado</label>
                <select value={form.status} onChange={e => setForm(p => ({ ...p, status: e.target.value }))} className="w-full border rounded px-3 py-2">
                  <option value="Pagado">Pagado</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="Reembolsado">Reembolsado</option>
                </select>
              </div>
              <div className="col-span-full relative">
                <label className="block text-sm font-bold mb-1">Cliente (opcional)</label>
                <input type="text" value={cliSearch} onChange={handleCliSearch} onFocus={() => setShowCliDrop(true)} placeholder="Buscar cliente..." className="w-full border rounded px-3 py-2" />
                {showCliDrop && clientes.length > 0 && (
                  <div className="absolute top-full left-0 right-0 bg-white border rounded mt-1 shadow-lg z-10 max-h-48 overflow-y-auto">
                    {clientes.filter(c => c.nombre.toLowerCase().includes(cliSearch.toLowerCase())).map((c: Cliente) => (
                      <button key={c.id} type="button" onClick={() => selectCliente(c)} className="w-full text-left px-4 py-2 hover:bg-gray-100 border-b last:border-b-0">
                        {c.nombre} {c.telefono && `(${c.telefono})`}
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
            <div className="flex justify-end gap-4 mt-6">
              <button type="button" onClick={() => setView('list')} className="btn bg-gray-500 text-white hover:bg-gray-600">Cancelar</button>
              <button type="submit" className="btn bg-blue-600 text-white hover:bg-blue-700">
                {editId ? 'Actualizar Pago' : 'Registrar Pago'}
              </button>
            </div>
          </form>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 p-6">
      <div className="max-w-6xl mx-auto">
        <div className="flex justify-between items-center mb-6">
          <h1 className="text-3xl font-bold">Registro de Pagos</h1>
          <button onClick={() => setView('form')} className="btn bg-blue-600 text-white hover:bg-blue-700">
            <Plus size={20} /> Nuevo Pago
          </button>
        </div>

        {/* Filtros */}
        <div className="bg-white rounded-lg shadow p-4 mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label className="block text-sm font-bold mb-1">Cliente</label>
            <div className="relative">
              <input type="text" value={getClienteNombre(filtros.cliente_id)} onChange={e => setFiltros(f => ({ ...f, cliente_id: clientes.find(c => c.nombre === e.target.value)?.id || '' }))} onFocus={() => setShowCliDrop(true)} placeholder="Filtrar por cliente..." className="w-full border rounded px-3 py-2" />
              {showCliDrop && clientes.length > 0 && (
                <div className="absolute top-full left-0 right-0 bg-white border rounded mt-1 shadow-lg z-10 max-h-48 overflow-y-auto">
                  {clientes.map((c: Cliente) => (
                    <button key={c.id} type="button" onClick={() => setFiltros(f => ({ ...f, cliente_id: c.id }))} className="w-full text-left px-4 py-2 hover:bg-gray-100 border-b last:border-b-0">
                      {c.nombre}
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div>
            <label className="block text-sm font-bold mb-1">Estado</label>
            <select value={filtros.status} onChange={e => setFiltros(f => ({ ...f, status: e.target.value }))} className="w-full border rounded px-3 py-2">
              <option value="">Todos</option>
              <option value="Pagado">Pagado</option>
              <option value="Pendiente">Pendiente</option>
              <option value="Reembolsado">Reembolsado</option>
            </select>
          </div>
          <div>
            <label className="block text-sm font-bold mb-1">Buscar</label>
            <input type="text" value={filtros.search} onChange={e => setFiltros(f => ({ ...f, search: e.target.value }))} placeholder="Buscar por descripción o cliente..." className="w-full border rounded px-3 py-2" />
          </div>
          <div>
            <label className="block text-sm font-bold mb-1">&nbsp;</label>
            <button onClick={() => setFiltros({ cliente_id: '', status: '', search: '' })} className="btn bg-gray-200 text-gray-800 hover:bg-gray-300 w-full">Resetear</button>
          </div>
        </div>

        {filteredPagos.length === 0 ? (
          <div className="bg-white rounded-lg shadow p-8 text-center">
            <p className="text-gray-500 text-lg">No hay pagos registrados o que coincidan con los filtros.</p>
          </div>
        ) : (
          <div className="bg-white rounded-lg shadow overflow-hidden">
            <table className="w-full text-sm">
              <thead>
                <tr className="bg-gray-100 border-b">
                  <th className="px-6 py-3 text-left font-bold">Fecha</th>
                  <th className="px-6 py-3 text-left font-bold">Cliente</th>
                  <th className="px-6 py-3 text-right font-bold">Monto</th>
                  <th className="px-6 py-3 text-left font-bold">Descripción</th>
                  <th className="px-6 py-3 text-left font-bold">Nro. Venta</th>
                  <th className="px-6 py-3 text-left font-bold">ID Stripe</th>
                  <th className="px-6 py-3 text-left font-bold">Estado</th>
                  <th className="px-6 py-3 text-right font-bold">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredPagos.map(pago => (
                  <tr key={pago.id} className="border-b hover:bg-gray-50">
                    <td className="px-6 py-3">{fmtDate(pago.fecha_pago)}</td>
                    <td className="px-6 py-3">{getClienteNombre(pago.cliente_id)}</td>
                    <td className="px-6 py-3 text-right font-bold">{fmt(pago.monto)}</td>
                    <td className="px-6 py-3">{pago.descripcion}</td>
                    <td className="px-6 py-3">{pago.nro_venta || '—'}</td>
                    <td className="px-6 py-3 text-xs">{pago.stripe_id || '—'}</td>
                    <td className="px-6 py-3"><span className={`px-2 py-1 rounded-full text-xs font-semibold ${getStatusColor(pago.status)}`}>{pago.status}</span></td>
                    <td className="px-6 py-3 text-right space-x-2">
                      <button onClick={() => editarPago(pago)} className="text-blue-600 hover:text-blue-800 font-semibold text-sm">Editar</button>
                      <button onClick={() => eliminarPago(pago.id)} className="text-red-600 hover:text-red-800 font-semibold text-sm">Eliminar</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
